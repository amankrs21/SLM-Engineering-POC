# Copy to .env, then set the key from your Mistral account.
MISTRAL_API_KEY=
# Must be available to your account; Large may require a different subscription tier.
MISTRAL_MODEL=mistral-large-4
# Optional: public Hugging Face downloads work without this; a token may avoid anonymous rate limits.
HF_TOKEN=
# Hosted retrieval POC (Jina embedding + rerank, Cohere rerank fallback).
JINA_API_KEY=
COHERE_TRIAL_KEY=
